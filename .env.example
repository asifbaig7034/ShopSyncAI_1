# Copy to .env, then replace this token with a new, private random value.
# The local-only token is retained for the UC-2 fictional demo verifier.
DEMO_MODE=true
SHOPSYNC_DEMO_OWNER_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_LOCAL_TOKEN

# Empty URI -> disposable in-memory sample DB, reset on server restart.
# For persistent history: start local MongoDB, then set the URI below.
MONGODB_URI=
MONGODB_DB=shopsync_ai

# UC-4 keeps a local, transaction-backed order/product ledger in SQLite during
# this integration phase. Use a durable, private path; never commit the DB.
# MongoDB remains the store for owner accounts, UC-2 history and UC-3 inbox.
SHOPSYNC_DB=data/shopsync-orders.sqlite3

# Ollama is a free local LLM option; pull the model into the optional Docker
# service before selecting it. Keep this URL on your own loopback interface.
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60

# Optional Gemini free-tier demo: fictional/synthetic owner requests ONLY.
# Unpaid-service terms prohibit personal, confidential or sensitive data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SYNTHETIC_DEMO=false
# Max total seconds for live intent classification (including one retry).
# The app explicitly warns if intent routing takes more than 3 seconds.
GEMINI_CLASSIFY_TIMEOUT_SECONDS=8

# UC-1 password recovery. Start the optional Mailpit service first, then set
# SMTP_HOST=127.0.0.1 in your private .env. An empty host disables email.
# Mailpit is a localhost-only test inbox; use authenticated TLS SMTP for real mail.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=shopsync@localhost
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Required to save live WhatsApp access tokens. Generate one Fernet key and
# keep it in your private .env; replacing it prevents old tokens being read.
# WhatsApp credentials are entered via the owner-only Settings screen.
INTEGRATION_ENCRYPTION_KEY=
# Supported version can be changed when Meta updates its Graph API.
META_GRAPH_VERSION=v26.0
