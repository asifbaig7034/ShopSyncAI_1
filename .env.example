# Copy to .env, then replace this token with a new, private random value.
# The local-only token is a UC-2 demo substitute; implement UC-1 auth later.
DEMO_MODE=true
SHOPSYNC_DEMO_OWNER_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_LOCAL_TOKEN

# Empty URI -> disposable in-memory sample DB, reset on server restart.
# For persistent history: start local MongoDB, then set the URI below.
MONGODB_URI=
MONGODB_DB=shopsync_ai

# Ollama is a free local LLM option; pull the model into the optional Docker
# service before selecting it. Keep this URL on your own loopback interface.
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60

# Optional Gemini free-tier demo: fictional/synthetic owner requests ONLY.
# Unpaid-service terms prohibit personal, confidential or sensitive data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SYNTHETIC_DEMO=false
# Max total seconds for live intent classification (including one retry).
# The app explicitly warns if intent routing takes more than 3 seconds.
GEMINI_CLASSIFY_TIMEOUT_SECONDS=8
