# Local demonstration only: no external messages and no paid LLM calls.
DEMO_MODE=true
STORAGE=memory
BUSINESS_ID=demo-business
DASHBOARD_API_TOKEN=demo-owner-token
CUSTOMER_AGENT_ENABLED=true
WHATSAPP_CONNECTED=true
LLM_PROVIDER=demo
CHANNEL=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mongo-backed demonstration (or replace with the team's shared Mongo database).
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=shopsync

# LLM_PROVIDER=openai enables live intent classification. Choose a model with
# Structured Outputs support; all factual replies are still rendered locally.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional business data. Never invent delivery times or fees.
DELIVERY_POLICY=

# UC-2 / UC-4 adapters: POST to these exact URLs using ../docs/INTEGRATION.md.
ORCHESTRATOR_URL=
ORDER_SERVICE_URL=
INTEGRATION_TOKEN=

# Real WhatsApp requires DEMO_MODE=false, STORAGE=mongo, LLM_PROVIDER=openai,
# CHANNEL=whatsapp, a strong unique DASHBOARD_API_TOKEN and all values below.
# Graph version has no stale hardcoded default. Use a supported version from Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
