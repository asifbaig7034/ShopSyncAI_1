# Copy to .env once, then edit .env with your own connection.
# Docker local option: docker compose up -d --wait
MONGODB_URI="mongodb+srv://sibghawaheed14:sibghawaheed14@cluster0.zem3qai.mongodb.net/"
MONGODB_DB="shopsync_uc4"

# Demonstration only; UC-1 authentication replaces this on integration.
SHOPSYNC_OWNER_TOKEN="my-local-project-token"
SHOPSYNC_RISK_AMOUNT_CENTS="2000000"
SHOPSYNC_RISK_THRESHOLD="50"
SHOPSYNC_RETURN_DAYS="14"

# Atlas alternative: replace MONGODB_URI above with your own cluster URI.
# MONGODB_URI="mongodb+srv://DB_USER:ENCODED_PASSWORD@YOUR_CLUSTER_HOST/?retryWrites=true&w=majority"

# Real integration tests need a DEVELOPMENT replica-set/Atlas URI.
# Test user needs create/drop permissions for temporary test databases.
# TEST_MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true"

